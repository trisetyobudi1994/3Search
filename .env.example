# ===== Scraper TikTok Shop (opsional) =====
# Tanpa token, aplikasi tetap berjalan dalam mode demo (data simulasi).
APIFY_TOKEN=
APIFY_ACTOR=herus13/tiktok-shop-scraper
# Batas waktu satu run actor, dalam detik (10-50).
APIFY_TIMEOUT_SECONDS=45
# Tambahan/override input actor sebagai JSON, mis. {"scrape_product_details":false}
APIFY_ACTOR_INPUT=

# ===== Konversi Rupiah (opsional) =====
# Dipakai untuk harga & simulasi profit dalam IDR pada region US/MY.
IDR_RATE_USD=16500
IDR_RATE_MYR=3700

# ===== Cache (opsional) =====
# Tanpa Redis, cache memakai memori proses selama server hidup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_MINUTES=360

# ===== Database feedback & statistik (opsional) =====
# Gunakan service role di server. Jangan pernah memakai prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
